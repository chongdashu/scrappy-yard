# Local configuration and credentials
.env
.env.*
!.env.example

# OS and language caches
.DS_Store
__pycache__/
*.py[cod]

# Build and dependency output
node_modules/
target/
/dist/
/release/
.wrangler/
.dev.vars
.dev.vars.*
*.tsbuildinfo

# Blender automatic backups
*.blend1
*.blend2

# Track runtime assets by default, including each game's public/assets/.
# Ignore a generated subtree only after adding and verifying its rebuild command.

# Generated by `npm run wasm` (cargo → <gameDir>/public/wasm/sim.wasm), in game/ and in every
# add-on; every dev, build, package and test:game path rebuilds it first. Verified from a
# clean export.
**/public/wasm/

# Local screenshots and test output (npm run smoke writes out/smoke/), packaging previews, raw
# captures, frame dumps and intermediate cuts. Commit only final, compressed media (see README:
# Assets and repository hygiene).
/out/
.tripo/

# Trailer HyperFrames scratch / captures (final web MP4s stay tracked when added)
share/media/trailer/**/frames/
share/media/trailer/**/renders/
share/media/trailer/**/.hyperframes/
share/media/trailer/**/project/assets/footage/
share/media/trailer/gameplay/broll/
share/media/trailer/**/*-master.mp4
share/media/trailer/project/

# Public snapshot: keep member-pack and private sources out if they reappear
.agents/
.claude/
addons/
prompt-templates/
skills.lock.json
wavedash.toml
*.blend
assets/blender/
assets/source/
experiments/
share/media/trailer/**/*-master.mp4
share/media/trailer/scrapyard-dash-trailer.mp4
share/media/trailer/scrappy-yard-trailer.mp4
