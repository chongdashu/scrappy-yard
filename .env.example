# Dev-server settings: copy to .env.local (ignored) to use them with npm run dev.
# Release builds ignore .env files: deploy/release.json sets every VITE_* value per target.
# A VITE_* value is bundled into the page and public; never put a secret in one.

# Pin the host adapter: web, wavedash or crazygames. Empty picks per page load:
# ?platform=<id> in the URL, else Wavedash when its SDK is injected, else web.
VITE_PLATFORM=
# "1" turns on CrazyGames ads (with VITE_PLATFORM=crazygames); ?ads does the same per page.
VITE_PLATFORM_ADS=

# The scripts read these from the shell environment (not from this file):
#   GAME_DIR        the active game folder for one command (default: game.config.json "gameDir"),
#                   e.g. GAME_DIR=addons/starter-arena npm run dev
#   BLENDER_BIN     Blender for an add-on's asset commands (npm run assets)
#   CHROME_BIN      Chrome for npm run smoke
#   VERCEL_ORG_ID, VERCEL_PROJECT_ID, VERCEL_SCOPE, VERCEL_PROJECT_NAME, VERCEL_DOMAIN
#                   npm run deploy:web (or deploy/web/project.json)
